HOST=127.0.0.1
PORT=8000
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# 通过非 localhost 域名/IP 访问 MCP 时，把 Host 加到这里（逗号分隔）
# MCP_ALLOWED_HOSTS=192.168.1.10:8000
# 彻底关闭 MCP 的 Host/Origin 校验（仅限可信反向代理后使用）
# MCP_DISABLE_HOST_CHECK=true
DEFAULT_MAX_ROWS=500
HARD_MAX_ROWS=5000
DEFAULT_QUERY_TIMEOUT=30
CONNECT_TIMEOUT=5
